    {
      "name": "4. Create",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 or 409\", function () {\r",
              "    pm.expect(pm.response.code).to.be.oneOf([201, 409]);\r",
              "});\r",
              "\r",
              "var responseData = pm.response.json();\r",
              "if (pm.response.code === 201 && responseData && responseData.length > 0) {\r",
              "    var hallId = responseData[0].id;\r",
              "    pm.environment.set(\"hall_id\", hallId);\r",
              "    // Sync target_hall_id fallback structure so step 5 and 6 stay valid dynamically\r",
              "    pm.environment.set(\"target_hall_id\", hallId);\r",
              "    console.log(\"Saved newly created hall ID: \" + hallId);\r",
              "} else if (pm.response.code === 409) {\r",
              "    console.log(\"Hall already exists (409). Keeping pre-existing environment configurations.\");\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "apikey",
            "value": "{{supabase_key}}",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          },
          {
            "key": "Prefer",
            "value": "return=representation",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"name\": \"TEST-Lab-04\",\r\n  \"location\": \"Engineering Building, 3rd Floor\",\r\n  \"rows\": 4,\r\n  \"columns\": 4,\r\n  \"hall_code\": \"HALL_TEST4\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        ],
        "url": {
          "raw": "{{supabase_url}}/rest/v1/halls",
          "host": [
            "{{supabase_url}}"
          ],
          "path": [
            "rest",
            "v1",
            "halls"
          ]
        }
      },
      "response": []
