  "item": [
    {
      "name": "1. Admin Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var data = pm.response.json();\r",
              "if (data.access_token) {\r",
              "    pm.environment.set(\"admin_token\", data.access_token);\r",
              "    console.log(\"Admin Token saved successfully!\");\r",
              "}\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "pm.test(\"Status code is 201\", function () {\r",
              "    pm.expect(pm.response.text()).to.include(\"access_token\"); \r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "apikey",
            "value": "{{supabase_key}}",
            "equals": true,
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{supabase_key}}",
            "equals": true,
            "type": "text"
          }
        ],
        "body": {
