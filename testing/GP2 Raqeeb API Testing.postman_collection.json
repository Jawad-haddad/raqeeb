          "listen": "test",
          "script": {
            "exec": [
              "// 1. Check if the server rejected the login (Status 400 Bad Request)\r",
              "// Note: Supabase usually returns 400 for bad passwords. If yours returns 401, change 400 to 401 below.\r",
              "pm.test(\"Status code is 400 (Login Failed)\", function () {\r",
              "    pm.response.to.have.status(400);\r",
              "});\r",
              "\r",
              "// 2. Check if the error message explains WHY (Security Check)\r",
              "pm.test(\"Error message says 'Invalid login credentials'\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    \r",
              "    // This checks the specific error code from Supabase\r",
              "    pm.expect(jsonData.error_code).to.eql(\"invalid_credentials\");\r",
              "    \r",
              "    // This checks the readable message\r",
              "    pm.expect(jsonData.msg).to.include(\"Invalid login credentials\");\r",
